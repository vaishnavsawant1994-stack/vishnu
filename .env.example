AI_PROVIDER=local
LOCAL_AI_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=llama3.2
# Production owner-controlled endpoint (OpenAI-compatible vLLM/llama.cpp/Ollama service)
SELF_HOSTED_AI_URL=
SELF_HOSTED_AI_API_KEY=
SELF_HOSTED_AI_MODEL=
MODEL_FALLBACK_PROVIDERS=
MODEL_DISABLED_PROVIDERS=
# Optional allow-list. Empty means use configured providers subject to privacy/capability/health policy.
MODEL_ALLOWED_PROVIDERS=
# P9 owner privacy policy: local_only | local_preferred | external_allowed
MODEL_PRIVACY_MODE=local_preferred
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_HEALTH_TIMEOUT_SECONDS=5
MODEL_RETRY_ATTEMPTS=1
MODEL_RETRY_BACKOFF_SECONDS=0.05
MODEL_MAX_FAILOVERS=5
MODEL_LOCAL_FIRST=true
ALLOW_EXTERNAL_FOR_SENSITIVE=false
MODEL_EVALUATION_ON_STARTUP=false

# Native Vishnu Intelligence Fabric rollout controls.
INTELLIGENCE_FABRIC_ENABLED=true
MULTI_PROVIDER_ROUTING_ENABLED=true
# Parallel durable work is opt-in until deployment-specific concurrency qualification is complete.
PARALLEL_AGENTS_ENABLED=false
MODEL_HANDOFF_ENABLED=true
# Multi-model compare/judge/synthesis is opt-in because it can multiply usage/cost.
MULTI_MODEL_DELIBERATION_ENABLED=false
AI_BUDGETS_ENABLED=true
MODEL_MAX_PARALLEL_CALLS=4
MODEL_MAX_PARALLEL_AGENTS=4
# 0 means no global cap at this layer; provider/account controls still apply.
MODEL_GLOBAL_MAX_COST=0
MODEL_GLOBAL_MAX_INPUT_TOKENS=0
MODEL_GLOBAL_MAX_OUTPUT_TOKENS=0
MODEL_GLOBAL_MAX_REQUESTS=0
MODEL_GLOBAL_MAX_RETRIES=0

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# Optional Google Gemini provider using Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# Adapter-ready OpenAI-compatible providers. These settings are inert until the
# provider is registered/qualified by the model router for the deployment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_PRIVATE=false

# P2.1 realtime / continuous voice
REALTIME_PROVIDER=auto
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_REASONING_EFFORT=low
REALTIME_SAFETY_IDENTIFIER=
REALTIME_INSTRUCTIONS=You are Vishnu. Be concise, natural, context-aware, and ask before taking consequential actions.
REALTIME_SAMPLE_RATE=24000
VOICE_PERSONALITY=calm, concise, warm and direct
VOICE_SPEAKING_RATE=1.0
VOICE_MIN_ENDPOINT_MS=420
VOICE_MAX_ENDPOINT_MS=1100
VOICE_NOISE_MULTIPLIER=2.4
VOICE_MIN_THRESHOLD=0.008
VOICE_MAX_UTTERANCE_SECONDS=45
VOICE_INPUT_DEVICE=
VOICE_OUTPUT_DEVICE=

VISION_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
AUTONOMY_MODE=ask

# P2.3 calm proactivity
PROACTIVE_ENABLED=true
PROACTIVE_INTERRUPTION_BUDGET_PER_HOUR=3
PROACTIVE_DEFAULT_COOLDOWN_SECONDS=1800

# P2.4 workflow defaults
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=120
WORKFLOW_DEFAULT_RETRIES=2

CONTROL_SERVER_ENABLED=false
CONTROL_SERVER_HOST=127.0.0.1
CONTROL_SERVER_PORT=8766
PAIRING_TTL_SECONDS=300
BROWSER_HEADLESS=false
# OS-path-separator-delimited directories tools may read/write. Defaults to Personal AI workspace only.
PERSONAL_AI_FILE_ROOTS=

# Optional secure cloud relay
CLOUD_RUNTIME_ENABLED=false
PERSONAL_AI_CLOUD_OWNER_SECRET=
CLOUD_SESSION_TTL_SECONDS=900
CLOUD_ALLOWED_ORIGINS=

# P3 iPhone-first PWA. Use a random value >=12 chars and keep insecure=false in production.
PERSONAL_AI_IPHONE_ENROLLMENT_CODE=
PERSONAL_AI_DEVICE_COOKIE_DAYS=365
PERSONAL_AI_IPHONE_ALLOW_INSECURE=false
# Optional Sign in with Google. Both values are required and only this exact verified email is accepted.
GOOGLE_SIGNIN_CLIENT_ID=
PERSONAL_AI_OWNER_GOOGLE_EMAIL=

# Optional legacy password. Leave blank to use OS keychain root-key protection.
PERSONAL_AI_VAULT_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional iOS push configuration
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=ai.personal.companion.ios
APNS_PRIVATE_KEY_B64=
APNS_ENVIRONMENT=development

# Signed releases / platform signing
RELEASE_PUBLIC_KEY_B64=
PERSONAL_AI_RELEASE_PRIVATE_KEY_B64=
WINDOWS_SIGNING_CERT_B64=
WINDOWS_SIGNING_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_TEAM_ID=
APPLE_NOTARY_PROFILE=

# Our Products commercial distribution signing. This is intentionally a
# separate trust domain from Vishnu application-release signing above.
# Both values are base64-encoded raw 32-byte Ed25519 keys; keep the private key
# only in the deployment secret store and never in Git or downloadable products.
VISHNU_PRODUCT_SIGNING_PUBLIC_KEY_B64=
VISHNU_PRODUCT_SIGNING_PRIVATE_KEY_B64=

# Dedicated Our Products platform-runner authentication. Use a long random token
# and store the same value only in the Vishnu deployment and trusted runner secret
# store. Runner uploads are bounded by the byte limit below (default 512 MiB).
VISHNU_PRODUCT_RUNNER_TOKEN=
VISHNU_PRODUCT_RUNNER_MAX_ARTIFACT_BYTES=536870912

# Optional production Android signing for client products. Without all four
# values, the Android platform runner builds a debug APK only; debug APKs are not
# marked production-distribution ready.
VISHNU_ANDROID_KEYSTORE_PATH=
VISHNU_ANDROID_KEY_ALIAS=
VISHNU_ANDROID_KEYSTORE_PASSWORD=
VISHNU_ANDROID_KEY_PASSWORD=

# Governed release / production autonomy.
# Leave all provider fields blank to keep release deployment authority disabled.
# Partial provider configuration fails closed at startup. Keep API tokens only
# in the deployment platform's protected secret store.

# Render: all five values are required together. Preview and production must be
# distinct services with provider auto-deploy disabled.
VISHNU_RELEASE_RENDER_API_TOKEN=
VISHNU_RELEASE_RENDER_PREVIEW_SERVICE_ID=
VISHNU_RELEASE_RENDER_PRODUCTION_SERVICE_ID=
VISHNU_RELEASE_RENDER_PREVIEW_URL=
VISHNU_RELEASE_RENDER_PRODUCTION_URL=

# Vercel: all six required values are configured together. Vishnu requires the
# project setting autoAssignCustomDomains=false, creates the exact candidate as
# a staged target=production deployment, qualifies that immutable URL, then
# promotes the same deployment without rebuilding it. Optional team/ref fields
# scope the provider precisely.
VISHNU_RELEASE_VERCEL_API_TOKEN=
VISHNU_RELEASE_VERCEL_PROJECT_ID=
VISHNU_RELEASE_VERCEL_PROJECT_NAME=
VISHNU_RELEASE_VERCEL_GITHUB_ORG=
VISHNU_RELEASE_VERCEL_GITHUB_REPO=
VISHNU_RELEASE_VERCEL_PRODUCTION_URL=
VISHNU_RELEASE_VERCEL_TEAM_ID=
VISHNU_RELEASE_VERCEL_GIT_REF=main
VISHNU_RELEASE_VERCEL_PREVIEW_HOST_SUFFIX=.vercel.app

# Optional when exactly one provider is configured. When multiple providers are
# configured this must explicitly name the intended provider (render or vercel).
VISHNU_RELEASE_DEFAULT_PROVIDER=
# Optional logical release target. Empty defaults to the EngineeringSpec repository.
VISHNU_RELEASE_TARGET=
# Read-only GET health path used for preview/staging and production qualification.
VISHNU_RELEASE_HEALTH_PATH=/health
# Read-only production observation cadence. Runtime clamps this to 30..3600 sec.
VISHNU_RELEASE_MONITOR_INTERVAL_SECONDS=60

# Durable state directory (set to the mounted volume path in production).
# Hosted startup fails closed unless this directory resolves beneath a proven
# mount rooted at PERSONAL_AI_DURABLE_ROOT.
PERSONAL_AI_DURABLE_ROOT=/data
PERSONAL_AI_DATA_DIR=/data/.personal_ai